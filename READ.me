# Все запущенные
docker ps

# Все (включая остановленные)
docker ps -a

# Только имена и порты
docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
# Статус
docker inspect --format='{{.State.Status}}' library-postgres
# → running

# Health
docker inspect --format='{{.State.Health.Status}}' library-postgres
# → healthy

# IP внутри сети
docker inspect --format='{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' library-postgres

Проверить, что БД реально отвечает:
docker exec -it library-postgres pg_isready -U library -d library
# → localhost:5432 - accepting connections

Или зайти в psql:
docker exec -it library-postgres psql -U library -d library -c '\l'
# → список баз, включая library

Проверить логи контейнера:
# Последние 50 строк
docker logs --tail 50 library-postgres

# В реальном времени
docker logs -f library-postgres

# С временными метками
docker logs -t library-postgres

docker compose -f docker/docker-compose.yml logs -f postgres
docker compose -f docker/docker-compose.yml logs -f --tail=100

Проверить ресурсы:
# Использование CPU/RAM по контейнерам
docker stats

# Без live-обновления
docker stats --no-stream

# Один контейнер
docker stats library-postgres --no-stream

