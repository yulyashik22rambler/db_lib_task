Запуск spring boot:
mvn spring-boot:run

# 1. Сбросить кэш путей
hash -r

# 2. Убедиться, что SDKMAN инициализирован в текущей сессии
source "$HOME/.sdkman/bin/sdkman-init.sh"

# 3. Проверить, какой mvn теперь резолвится
which mvn
# ожидаемо: /home/julia/.sdkman/candidates/maven/current/bin/mvn

# 4. Версия
mvn -version
# → Apache Maven 3.9.9, Java 17
