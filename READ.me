Проверить, что docker демон запущен:
docker info

Без длинного вывода:
docker info > /dev/null 2>&1 && echo "Docker OK" || echo "Docker НЕ работает"

# Статус
sudo systemctl status docker

# Ожидаемо:
#   ● docker.service - Docker Application Container Engine
